# Required. Get a key at https://aistudio.google.com/apikey. It stays on the server.
GEMINI_API_KEY=

# Gemini Live model. If Google renames it, copy the current name from https://ai.google.dev/gemini-api/docs/live
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Sessions one visitor (IP address) may start per hour. Each session costs Gemini usage on your key.
TOKENS_PER_HOUR=30

# Local debugging only: send the raw key to the browser instead of a one-use token. Ignored in production builds.
ALLOW_RAW_KEY=0
